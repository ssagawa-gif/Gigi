# Copy this file to .env.local and fill in (Supabase > Project Settings > API).
# With these empty, the app runs in sample mode (data stays in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: your Tally waitlist link. Empty = the built-in waitlist form (saved in Supabase).
VITE_WAITLIST_URL=
