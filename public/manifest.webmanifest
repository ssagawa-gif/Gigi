{
  "name": "GiGi · Women's health concierge",
  "short_name": "GiGi",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F5EEE8",
  "theme_color": "#561821",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "report", "accept": ["application/pdf", ".pdf", "image/*"] }] }
  }
}
